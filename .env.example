
OPENAI_API_KEY=

# Folders: RAW_DIR holds the downloaded PDFs (never changed); the others are filled by scripts
RAW_DIR=            # e.g. /Users/you/Downloads/Mandera
CORPUS_DIR=         # default corpus/        (build_corpus.py: text PDFs only)
PILOT_DIR=          # default corpus_pilot/  (pick_pilot.py: 50-PDF sample)

# Models: cheap one for building, stronger one for the judge and final scores
LLM_MODEL=
JUDGE_MODEL=

# Embeddings: local MiniLM (free). Set EMBED_PROVIDER=openai to switch to OpenAI.
EMBED_PROVIDER=
EMBED_MODEL=
# EMBED_MODEL=text-embedding-3-small    # if EMBED_PROVIDER=openai

# --- Optional free fallback ---
# GOOGLE_API_KEY=

# --- Cost safety ---
LLM_CACHE_DIR=
MAX_AGENT_STEPS=